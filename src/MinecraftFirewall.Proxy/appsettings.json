{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/MinecraftFirewall/logs/proxy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ServerProfiles": [
    {
      "Name": "ExampleServer",
      "PublicPort": 25565,
      "BackendHost": "127.0.0.1",
      "BackendPort": 25566,
      "VpnPolicy": "BlockForProtectedUsernamesOnly",
      "UseDatacenterList": false,
      "ProtectedUsernames": [
        {
          "Username": "YourAdminUsername",
          "AllowedIps": [ "203.0.113.7" ]
        }
        // To lock a username to its genuine Microsoft/Mojang account owner, add it with
        // "RequirePremium": true — no AllowedIps needed, and no password is ever asked of the real
        // owner. Nobody else can then use that name, even though the backend stays online-mode=false.
        // ,{ "Username": "YourPremiumName", "AllowedIps": [], "RequirePremium": true }
      ],
      // Optional. When non-empty, only connections whose Handshake hostname matches one of these
      // (exact, or "*.example.com" for any subdomain) are allowed — direct-IP connects are denied.
      // Leave empty (or omit) for no restriction. If you test from the same machine, add "localhost"
      // here too, or you will lock yourself out. See README's "Honesty notes" for what this does and
      // does not guarantee — it is not a substitute for a firewall rule.
      "AllowedHostnames": []
    }
  ],

  "VpnIntel": {
    "VpnListUrl": "https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt",
    "DatacenterListUrl": "https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/datacenter/ipv4.txt",
    "CacheDirectory": "C:/ProgramData/MinecraftFirewall/cache",
    "RefreshInterval": "1.00:00:00",
    "HttpTimeout": "00:00:30"
  },

  "RateLimits": {
    "StatusPingMaxPerWindow": 20,
    "StatusPingWindow": "00:00:10",
    "LoginMaxPerWindow": 5,
    "LoginWindow": "00:00:30"
  },

  "FirewallBan": {
    "DefaultBanDuration": "06:00:00",
    "StrikesBeforeBan": 5,
    "CleanupInterval": "00:01:00"
  },

  "NeverBan": {
    "ExtraAllowlist": []
  },

  // Secondary, real-time VPN/hosting-provider signal via ipinfo.io — independent of and in addition
  // to the VpnIntel list above. Disabled by default (empty Token = no outbound requests at all).
  // To enable: sign up free at https://ipinfo.io/signup (no credit card) and paste your token below.
  // NOTE: verified empirically — ipinfo's free "Lite" tier still requires this token; it is not
  // keyless despite being free. It also returns ASN/organization name, not a dedicated VPN flag (that
  // is a separate paid ipinfo product) — this app treats a hosting-provider-looking org name as a
  // heuristic signal, feeding the same VpnPolicy decision as the list above.
  "IpInfo": {
    "Token": "",
    // false (default) = only checked for protected/identity-gated usernames. true = every login.
    "ApplyToAllConnections": false,
    "CacheTtl": "06:00:00",
    "HttpTimeout": "00:00:03"
  },

  // Where runtime-learned identity state is kept across restarts: self-registered CaYaDev-Check
  // password hashes, learned IPs, and the Mojang UUID each premium name is pinned to. Without this,
  // a restart would un-claim every premium name and forget every registered player.
  // Admin-declared fields (AllowedIps, RequirePremium) are deliberately NOT stored here — this file
  // above is their single source of truth, so removing a name from it really does remove it.
  // The store contains password hashes: it is written with inheritance disabled and access limited to
  // Administrators, SYSTEM, and the account the service runs as. Keep it out of backups you share.
  "IdentityPersistence": {
    "Enabled": true,
    "FilePath": "C:\\ProgramData\\MinecraftFirewall\\identity-store.json",
    "SaveInterval": "00:00:30"
  },

  // Premium (real Mojang account) verification for usernames marked "RequirePremium": true above.
  // Such a name is challenged with a real encryption handshake and checked against Mojang's session
  // server; the first account to pass permanently owns the name, and nobody else can ever use it.
  // Setting Enabled to false does NOT fall back to the password/IP checks for those names — it
  // denies them outright, because falling back would hand the name to exactly whoever the admin
  // marked it premium to keep out. To relax protection on a name, remove its RequirePremium flag.
  "Premium": {
    "Enabled": true,
    "HttpTimeout": "00:00:05"
  },

  // All player-facing kick/disconnect text. Defaults (baked into the app) are English — every field
  // here is optional; omit any you don't want to change. Uncomment and edit for Turkish, or any other
  // language/wording. This is the ONLY place these strings live — nothing is hardcoded in the app.
  "Messages": {
    "GenericDenied": "This connection was blocked by MinecraftFirewall.",
    "UnsupportedClientVersion": "This client version is not supported by the server's protection layer. Contact the server administrator.",
    "HostnameNotAllowed": "This server can only be reached through its allowed address(es).",
    "DangerousCommandBlocked": "You are not authorized to use that command. Your connection was closed for security reasons.",
    "GraceAuthenticationFailed": "Authentication failed. This IP is not recognized and the correct password was not provided.",
    "PremiumVerificationFailed": "This username is reserved for its verified Minecraft account owner. Sign in with the genuine account and try again."
    // Turkish example — replace the values above with these to switch:
    // "GenericDenied": "Bu bağlantı MinecraftFirewall tarafından engellendi.",
    // "UnsupportedClientVersion": "Bu istemci sürümü desteklenmiyor. Sunucu yöneticisine başvurun.",
    // "HostnameNotAllowed": "Bu sunucuya sadece izin verilen adres(ler) üzerinden bağlanılabilir.",
    // "DangerousCommandBlocked": "Bu komut için yetkiniz yok. Bağlantınız güvenlik nedeniyle kesildi.",
    // "GraceAuthenticationFailed": "Kimlik doğrulama başarısız. Bu IP tanınmıyor ve doğru şifre girilmedi.",
    // "PremiumVerificationFailed": "Bu kullanıcı adı, doğrulanmış Minecraft hesabı sahibine ayrılmıştır. Gerçek hesapla giriş yapın."
  }
}
