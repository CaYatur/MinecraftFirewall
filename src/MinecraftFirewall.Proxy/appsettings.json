{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/MinecraftFirewall/logs/proxy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  // Your servers. This is the one section the control panel writes to, which is why its explanation
  // lives out here rather than inside the array: the panel replaces the array wholesale when you save
  // the Servers page, so anything written between the brackets would be lost the first time somebody
  // renamed a server. Everything outside is preserved byte-for-byte.
  //
  //   Name           A label for you. Appears in the log and in the control panel.
  //   PublicPort     What players connect to.
  //   BackendHost    Where your real Minecraft server is. Keep it on 127.0.0.1.
  //   BackendPort    The port from your server.properties. Must NOT be reachable from outside.
  //
  //   ProtectedUsernames
  //     { "Username": "Name", "AllowedIps": [ "203.0.113.7", "10.0.0.0/8" ] }
  //       Only those addresses may use the name. Anyone else is refused outright.
  //     { "Username": "Name", "AllowedIps": [], "RequirePremium": true }
  //       Locks the name to its genuine Microsoft/Mojang account owner. No AllowedIps needed, and the
  //       real owner is never asked for a password from any address. Nobody else can use the name,
  //       even though your server stays online-mode=false.
  //
  //   AllowedHostnames
  //     Optional. When non-empty, only connections whose Handshake hostname matches one of these
  //     (exact, or "*.example.com" for any subdomain) are allowed, so direct-IP connects are refused.
  //     Empty (default) means no restriction. If you test from this machine, add "localhost" too, or
  //     you will lock yourself out.
  //     Read the README's honesty notes before relying on it: a custom client can lie about this
  //     field, so it stops IP-scanning bots and casual direct joins but is not a boundary. The thing
  //     that actually enforces "only through my domain" is your real server being unreachable except
  //     from this proxy — which is exactly what the control panel's Security check tests.
  "ServerProfiles": [
    {
      "Name": "ExampleServer",
      "PublicPort": 25565,
      "BackendHost": "127.0.0.1",
      "BackendPort": 25566,
      "VpnPolicy": "BlockForProtectedUsernamesOnly",
      "UseDatacenterList": false,
      "ProtectedUsernames": [
        {
          "Username": "YourAdminUsername",
          "AllowedIps": [ "203.0.113.7" ]
        }
      ],
      "AllowedHostnames": []
    }
  ],

  "VpnIntel": {
    "VpnListUrl": "https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt",
    "DatacenterListUrl": "https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/datacenter/ipv4.txt",
    "CacheDirectory": "C:/ProgramData/MinecraftFirewall/cache",
    "RefreshInterval": "1.00:00:00",
    "HttpTimeout": "00:00:30"
  },

  "RateLimits": {
    "StatusPingMaxPerWindow": 20,
    "StatusPingWindow": "00:00:10",
    "LoginMaxPerWindow": 5,
    "LoginWindow": "00:00:30"
  },

  // Admission control at the moment a connection is accepted, before a single byte is read. The
  // defaults are set so a household or small community never notices them: a limit tight enough to
  // be tripped by six friends behind one router gets switched off, and then it protects nothing.
  "DdosProtection": {
    "Enabled": true,
    // Connections held open at once. One player uses one, plus a brief second while their client
    // refreshes the server list, so 16 leaves room for a dozen people sharing one home connection.
    "MaxConcurrentPerIp": 16,
    // The same limit widened to the /24 the address sits in. A botnet spread across neighbouring
    // addresses is invisible per-address and obvious per-subnet.
    "MaxConcurrentPerSubnet": 64,
    "MaxConcurrentTotal": 1000,
    // Connect-and-drop never shows up in a concurrency count, so reconnect storms need their own cap.
    "MaxNewConnectionsPerIpPerMinute": 60,
    "MaxNewConnectionsPerSubnetPerMinute": 300,
    // Crossing this puts the limits above into a tightened mode for the cooldown below. It is a mode
    // rather than a permanent setting because the tighter limits do cost legitimate players
    // something, and that cost is only worth paying while something is actually happening.
    "AcceptsPerSecondBeforeDefensiveMode": 150,
    "UnderAttackTightening": 0.35,
    "UnderAttackCooldown": "00:00:45",
    "StrikeWeightOnFlood": 1
  },

  // Scoring for join behaviour that does not look like a person: logging in without ever asking for
  // the server list, working through a list of usernames, reconnecting on a metronome, and so on.
  // No single signal is proof — each has an innocent explanation — so they are weighted and summed.
  //
  // Action starts at "LogOnly" deliberately. Turning a heuristic loose on a live server before anyone
  // has seen what it scores is how a firewall ends up refusing its own owner. Watch the log (or the
  // control panel) for a while, then switch to "Deny" if the scores look right on YOUR server.
  //
  // What actually reaches DenyScore, with the shipped weights:
  //   no ping + several usernames                    35 + 55 = 90    refused
  //   pings first, several usernames, looping             55 + 45 = 100   refused
  //   no ping + generated name + on a threat list    35 + 20 + 45 = 100   refused
  //   looping alone, or a threat-list hit alone           45              allowed
  // No single signal can refuse anyone on its own — an imported list least of all.
  "BotDefense": {
    "Enabled": true,
    "Action": "LogOnly",
    "DenyScore": 90,
    "ReportScore": 60,
    "StrikeWeightOnDeny": 1
  },

  // Decoy ports. A player's client connects to the port you gave them and has no reason to try the
  // one next door, or the RCON port — so anything that does is enumerating, not playing.
  //
  // Off by default because binding extra ports is a visible change to your machine and can collide
  // with something you actually run. The ports below are the ones scanners reach for first; any that
  // one of your own servers already uses is skipped automatically with a warning.
  "Honeypot": {
    "Enabled": false,
    "Ports": [ 25567, 25570, 25575 ],
    // The full ban threshold: one hit is enough, because unlike every other signal here there is no
    // innocent reading of a connection to a port nothing advertises. The NeverBan allowlist still
    // applies, so scanning your own machine can never lock you out.
    "StrikeWeight": 5,
    "RecordToThreatList": true
  },

  // Addresses seen attacking somewhere, imported from public lists, plus the ones this installation
  // has caught on its own honeypot ports.
  //
  // There is no central MinecraftFirewall service collecting these — a blocklist anyone can write to
  // by tripping a honeypot would be a denial-of-service tool. What this does instead is read any list
  // served as one address or CIDR per line, which is the format every public feed already uses, and
  // write its own findings out the same way, so a community that wants a shared feed can host the
  // file. The default is IPsum level 3: addresses on at least three independent public blacklists.
  //
  // "Score" (default) lets it tip a connection that was already behaving oddly. "Block" refuses on
  // the list alone — someone else's judgement about traffic that was never aimed at your server, so
  // it is not the default. "LogOnly" just records it.
  "ThreatIntel": {
    "Enabled": true,
    "FeedUrls": [ "https://raw.githubusercontent.com/stamparm/ipsum/master/levels/3.txt" ],
    "Action": "Score",
    "ScoreWeight": 45,
    "RefreshInterval": "1.00:00:00",
    "CacheDirectory": "C:/ProgramData/MinecraftFirewall/cache",
    "LocalThreatLogPath": "C:/ProgramData/MinecraftFirewall/threats-observed.txt",
    "LocalRetention": "30.00:00:00"
  },

  // Inspection of what a client sends after it has been let in.
  //
  // The split running through this section is between protocol violations and suspicious play. A NaN
  // coordinate, a chat string longer than the protocol allows, a Log4j-style lookup in a message —
  // no Minecraft client produces these, so refusing them costs nobody anything and they are on.
  // Moving faster than seems possible is a different kind of claim: this proxy sees coordinates and
  // nothing else. It cannot see ice, boats, elytra, riptide tridents, speed potions, slime blocks or
  // a plugin's /tp, all of which look exactly like a speed cheat from here. So movement is reported
  // and not enforced unless you turn KickOnMovementAnomaly on yourself, after watching your own
  // server's numbers.
  "DeepInspection": {
    "Enabled": true,
    "MaxServerboundFrameBytes": 262144,
    "MaxServerboundUncompressedBytes": 524288,
    "MaxPacketsPerSecond": 200,
    "MaxBytesPerSecond": 524288,
    "MaxChatLength": 256,
    "ScanForInjectionPayloads": true,
    "MaxPluginMessageBytes": 32768,
    "BlockImpossibleCoordinates": true,
    "AnalyseMovement": true,
    "KickOnMovementAnomaly": false,
    "MaxHorizontalBlocksPerSecond": 22.0,
    "MaxVerticalBlocksPerSecond": 14.0,
    "MovementAnomaliesBeforeReport": 6,
    "MaxAttacksPerSecond": 30
  },

  // Statistical anomaly detection: learns what ordinary connections to YOUR server look like and
  // reports the ones that do not fit. Every other check here encodes a rule somebody wrote down, and
  // rules only catch what their author thought of; a technique nobody has seen before still has to
  // produce network behaviour, and behaviour unlike everything else is what gets reported.
  //
  // Off by default, and it reports rather than blocks — with no setting to change that. Two reasons,
  // both worth understanding before switching it on:
  //
  //   It learns from live traffic, so an attacker present during the learning window becomes part of
  //   the baseline. That is inherent to training on production data. It is narrowed by learning only
  //   from connections that ended cleanly and never earned a strike, by requiring a few hundred
  //   samples before scoring anything, and by using a rolling window rather than a growing history.
  //
  //   What it detects is "unlike the other connections to this server", which is not the same claim
  //   as "malicious". A server whose players are all in one timezone will flag an unusual-hours
  //   visitor, correctly and unhelpfully. Only a person can supply the missing judgement.
  //
  // Action decides what a REPEATED anomaly may cause, in increasing order of consequence:
  //
  //   "Report"                   write it down, nothing else                        (default)
  //   "Score"                    count it towards the address's bot score
  //   "RequireReauthentication"  next connection must log in again, even from a known address
  //   "Throttle"                 tighten that address's connection limits for ActionDuration
  //   "Ban"                      a real firewall ban for ActionDuration
  //
  // Nothing happens on a single odd session — sessions are odd for innocent reasons constantly — and
  // nothing happens at all until the model has been settled for SettlingPeriod, because a freshly
  // trained baseline is least reliable exactly when it is newest. Every action lands on the address's
  // NEXT connection rather than the one just scored, which is inherent: the model judges a whole
  // session, so by the time it has an opinion the session is over. The upshot is that the worst this
  // can do to somebody mid-game is nothing.
  "AnomalyDetection": {
    "Enabled": false,
    "Action": "Report",
    "RepeatedAnomaliesBeforeAction": 3,
    "AnomalyMemory": "06:00:00",
    "SettlingPeriod": "01:00:00",
    "ActionDuration": "06:00:00",
    "ScoreWeight": 40,
    "MinimumSamplesBeforeScoring": 300,
    "BaselineWindow": 5000,
    // Which fraction of your own connections counts as ordinary. At 0.99, only connections scoring
    // above the most unusual 1% of the baseline are reported. A percentile rather than a fixed score,
    // because raw anomaly scores are not comparable between servers.
    "AnomalyPercentile": 0.99,
    "Trees": 64,
    "SubsampleSize": 256,
    "RetrainInterval": "00:10:00"
  },

  // Repeat offenders serve longer each time: 6 hours, then 12, then a day, two days, four, and so on
  // to the cap. A flat ban is not a deterrent to anything automated — it is a schedule, and a bot that
  // returns every evening pays the same price every evening. Doubling makes persistence cost more each
  // time, while leaving the case that matters alone: someone who trips a limit once, and again months
  // later, never reaches the interesting part of the curve.
  //
  // The count decays (RepeatOffenceMemory, measured from the last ban) and is capped, because
  // addresses get reassigned — today's attacker is somebody's home connection next year. An admin
  // unbanning by hand clears the history; a ban simply expiring does not, which is the whole point.
  //
  // Held in memory, so a service restart forgives everyone. That is deliberate: this is a deterrent
  // rather than a security boundary, and it is not worth another file on disk listing addresses and
  // their sentences.
  "FirewallBan": {
    "DefaultBanDuration": "06:00:00",
    "EscalateRepeatOffenders": true,
    "MaxBanDuration": "30.00:00:00",
    "RepeatOffenceMemory": "14.00:00:00",
    "StrikesBeforeBan": 5,
    "CleanupInterval": "00:01:00"
  },

  "NeverBan": {
    "ExtraAllowlist": []
  },

  // Secondary, real-time VPN/hosting-provider signal via ipinfo.io — independent of and in addition
  // to the VpnIntel list above. Disabled by default (empty Token = no outbound requests at all).
  // To enable: sign up free at https://ipinfo.io/signup (no credit card) and paste your token below.
  // NOTE: verified empirically — ipinfo's free "Lite" tier still requires this token; it is not
  // keyless despite being free. It also returns ASN/organization name, not a dedicated VPN flag (that
  // is a separate paid ipinfo product) — this app treats a hosting-provider-looking org name as a
  // heuristic signal, feeding the same VpnPolicy decision as the list above.
  "IpInfo": {
    "Token": "",
    // false (default) = only checked for protected/identity-gated usernames. true = every login.
    "ApplyToAllConnections": false,
    "CacheTtl": "06:00:00",
    "HttpTimeout": "00:00:03"
  },

  // Optional Discord notifications, in addition to the log file. Off by default (empty URL = no
  // queue, no outbound requests at all). Create a webhook in your Discord channel's settings and
  // paste its URL here — treat it as a secret, anyone holding it can post to that channel.
  // Alerting never blocks or fails a player's connection: if Discord is down, the alert is dropped
  // and proxying carries on. Under a flood, alerts are queued (bounded), paced, and any drops are
  // reported in the next message rather than hidden.
  "Alerts": {
    "DiscordWebhookUrl": "",
    "MinimumInterval": "00:00:02",
    "MaxQueuedAlerts": 200,
    "HttpTimeout": "00:00:05",
    "OnBan": true,
    // A registered player authenticating from a brand-new IP. Low volume, and the whole point is
    // that a stolen password shows up as a visible event instead of silently working.
    "OnNewTrustedIp": true,
    "OnPremiumVerificationFailure": true,
    "OnDangerousCommand": true
  },

  // Where runtime-learned identity state is kept across restarts: self-registered CaYaDev-Check
  // password hashes, learned IPs, and the Mojang UUID each premium name is pinned to. Without this,
  // a restart would un-claim every premium name and forget every registered player.
  // Admin-declared fields (AllowedIps, RequirePremium) are deliberately NOT stored here — this file
  // above is their single source of truth, so removing a name from it really does remove it.
  // The store contains password hashes: it is written with inheritance disabled and access limited to
  // Administrators, SYSTEM, and the account the service runs as. Keep it out of backups you share.
  // AuthMe-style accounts. Off by default: switching it on changes what joining means for everyone at
  // once. With it off, the password system is opt-in — a player who types /register gets their name
  // protected and everybody else plays as before. With it on, a player joins but cannot move, hit,
  // place, or open anything until they have registered or logged in; only chat gets through, which is
  // how they type the command. Keep-alives keep flowing, so the server does not time them out while
  // they read the prompt.
  //
  // Premium-locked names skip this entirely, and that is deliberate rather than an oversight. A name
  // proven to belong to a real Microsoft account has already been authenticated by something far
  // stronger than a password stored here, and asking for one on top would mean making the genuine
  // owner prove themselves twice.
  "Identity": {
    "RequireRegistrationForEveryone": false,
    "AuthenticationTimeout": "00:02:00",
    "AuthenticationReminderInterval": "00:00:10",
    "PasswordMinLength": 6,
    "LearnedIpTtl": "30.00:00:00",
    "MaxLearnedIpsPerUsername": 5
  },

  // Teaching the firewall a Minecraft version it does not know, by itself, while it is running.
  //
  // On by default, because the alternative is worse and silent: the day a new Minecraft version ships
  // is the day protected usernames stop being defensible on it, and that gap lasts until somebody
  // notices, a new build is made, and you install it.
  //
  // What makes it safe to run unattended is the check, not the source. minecraft-data is a community
  // dataset, so nothing it says is believed on its own — before a single new table is accepted, the
  // fetched data must first reproduce EVERY table this build compiled in from Mojang's own data
  // generator, exactly. One disagreement and the whole fetch is discarded. A source that agrees on all
  // twelve known versions is not guessing about the thirteenth; a source that has drifted or been
  // tampered with fails long before it can teach the firewall to misread a packet.
  //
  // It is plain JSON over HTTPS. Nothing is downloaded that runs — which is why this and not Mojang's
  // own generator, since that would mean fetching a 50 MB server jar and executing it, and a security
  // product should not quietly do that on its own initiative.
  //
  // If it fails, nothing changes: unknown version, fail closed for protected names, ordinary players
  // unaffected exactly as before. Learned tables never override a compiled-in one.
  "ProtocolLearning": {
    "Enabled": true,
    "DataSourceUrl": "https://raw.githubusercontent.com/PrismarineJS/minecraft-data/master/data",
    "HttpTimeout": "00:00:30",
    "RetryInterval": "06:00:00",
    "StorePath": "C:\\ProgramData\\MinecraftFirewall\\learned-protocols.json"
  },

  "IdentityPersistence": {
    "Enabled": true,
    "FilePath": "C:\\ProgramData\\MinecraftFirewall\\identity-store.json",
    "SaveInterval": "00:00:30"
  },

  // Premium (real Mojang account) verification for usernames marked "RequirePremium": true above.
  // Such a name is challenged with a real encryption handshake and checked against Mojang's session
  // server; the first account to pass permanently owns the name, and nobody else can ever use it.
  // Setting Enabled to false does NOT fall back to the password/IP checks for those names — it
  // denies them outright, because falling back would hand the name to exactly whoever the admin
  // marked it premium to keep out. To relax protection on a name, remove its RequirePremium flag.
  "Premium": {
    "Enabled": true,
    "HttpTimeout": "00:00:05",
    // Off by default, and worth understanding before switching on. When true, any username nobody has
    // declared gets offered the chance to prove it owns a genuine Minecraft account; if it does, that
    // name is locked to that account permanently. A failed check records NOTHING — the player simply
    // joins as usual and the real owner can still claim the name later by connecting once, so nobody
    // can "burn" a name by getting there first with a cracked client.
    // The cost: every new player's client is asked to answer an encryption challenge. Genuine clients
    // do this silently, and clients that answer but fail the check are still let through — but a
    // launcher that mishandles the request outright will fail to connect. Test it before relying on it.
    "AutoClaimOnVerifiedLogin": false
  },

  // All player-facing kick/disconnect text. Defaults (baked into the app) are English — every field
  // here is optional; omit any you don't want to change. Uncomment and edit for Turkish, or any other
  // language/wording. This is the ONLY place these strings live — nothing is hardcoded in the app.
  "Messages": {
    "GenericDenied": "This connection was blocked by MinecraftFirewall.",
    // Only ever shown to a connection using a PROTECTED username (premium-locked, or password-registered
    // and arriving from a new address) on a client version this build has no verified packet table for.
    // Ordinary players on any version — including anything arriving through ViaVersion — are unaffected
    // and never see this: the firewall simply relays their connection without inspecting it.
    "UnsupportedClientVersion": "This username is protected, and protecting it needs a client version this server's firewall knows. Yours is not one of them yet. Other players are unaffected — ask the administrator to update MinecraftFirewall, or join with a supported version.",
    "HostnameNotAllowed": "This server can only be reached through its allowed address(es).",
    "DangerousCommandBlocked": "You are not authorized to use that command. Your connection was closed for security reasons.",
    "GraceAuthenticationFailed": "Authentication failed. This IP is not recognized and the correct password was not provided.",
    "PremiumVerificationFailed": "This username is reserved for its verified Minecraft account owner. Sign in with the genuine account and try again.",

    // The player-initiated premium lock. Any player can type /premium in chat to ask what locking
    // their own name would do, and /premium confirm to go ahead — which works whether or not
    // Premium.AutoClaimOnVerifiedLogin is switched on above, because that setting decides whether
    // EVERYONE is offered the challenge, which is a different question from whether one person asked
    // for it.
    //
    // Safe for the same reason auto-claim is: Mojang is asked whether THIS username has an active
    // session, so the only account that can ever answer for a name is the one that owns it. Somebody
    // squatting a name with a cracked client can arm this all they like — the challenge they then have
    // to pass is one only the real owner can pass, and a failure records nothing at all.
    "PremiumLockExplain": "Locking your name means only your real Minecraft account can ever use it on this server, from any address, and you will never be asked for a password. This cannot be undone by you afterwards. To go ahead, type /premium confirm — you will be disconnected, and must rejoin using the genuine account.",
    "PremiumLockArmed": "Ready. Rejoin now with the real Minecraft account that owns this name, and it will be locked to it. If you rejoin with anything else, nothing is recorded and you simply play as usual.",
    "PremiumLockSucceeded": "Your name is now locked to this Minecraft account. Nobody else can use it on this server.",

    // Shown in chat while a player is held still waiting to register or log in, so these are longer
    // and more instructional than the kick messages above: somebody reading one is stuck.
    "RegistrationPrompt": "This server requires an account. Type  /register <password>  to create one. You cannot move or interact until you do. Choose something you have not used elsewhere.",
    "LoginPrompt": "Welcome back. Type  /login <password>  to continue. You cannot move or interact until you do.",
    "AuthenticationAccepted": "Authenticated. Have fun.",
    "PasswordTooShort": "That password is too short — it needs at least {0} characters. Try again with  /register <password>",
    "AuthenticationTimedOut": "You did not register or log in within the time allowed. Reconnect and try again."
    // Turkish example — replace the values above with these to switch:
    // "GenericDenied": "Bu bağlantı MinecraftFirewall tarafından engellendi.",
    // "UnsupportedClientVersion": "Bu istemci sürümü desteklenmiyor. Sunucu yöneticisine başvurun.",
    // "HostnameNotAllowed": "Bu sunucuya sadece izin verilen adres(ler) üzerinden bağlanılabilir.",
    // "DangerousCommandBlocked": "Bu komut için yetkiniz yok. Bağlantınız güvenlik nedeniyle kesildi.",
    // "GraceAuthenticationFailed": "Kimlik doğrulama başarısız. Bu IP tanınmıyor ve doğru şifre girilmedi.",
    // "PremiumVerificationFailed": "Bu kullanıcı adı, doğrulanmış Minecraft hesabı sahibine ayrılmıştır. Gerçek hesapla giriş yapın."
  }
}
