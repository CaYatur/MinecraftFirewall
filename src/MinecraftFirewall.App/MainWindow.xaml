<Window x:Class="MinecraftFirewall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MinecraftFirewall.App.Localization"
        Title="MinecraftFirewall" Height="760" Width="1120" MinHeight="620" MinWidth="940"
        Background="{StaticResource BgWash}" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock FontSize="17" FontWeight="Bold">
                        <Run Text="MINECRAFT" Foreground="#F4F3F5"/><Run Text="FIREWALL" Foreground="#E11D2A"/>
                    </TextBlock>
                    <TextBlock x:Name="TaglineText" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0"
                               Text="{loc:T AppTagline}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="14,0,14,14" CornerRadius="3" Padding="13,11"
                        Background="#12070A" BorderBrush="#3A1620" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="13" Text="…"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                    <RadioButton x:Name="NavStatus"   Style="{StaticResource NavButton}" Content="{loc:T NavStatus}"   IsChecked="True" Checked="Nav_Checked" Tag="Status"/>
                    <RadioButton x:Name="NavServers"  Style="{StaticResource NavButton}" Content="{loc:T NavServers}"  Checked="Nav_Checked" Tag="Servers"/>
                    <RadioButton x:Name="NavSecurity" Style="{StaticResource NavButton}" Content="{loc:T NavSecurity}" Checked="Nav_Checked" Tag="Security"/>
                    <RadioButton x:Name="NavDefense" Style="{StaticResource NavButton}" Content="{loc:T NavDefense}" Checked="Nav_Checked" Tag="Defense"/>
                    <RadioButton x:Name="NavBans"     Style="{StaticResource NavButton}" Content="{loc:T NavBans}"     Checked="Nav_Checked" Tag="Bans"/>
                    <RadioButton x:Name="NavLog"      Style="{StaticResource NavButton}" Content="{loc:T NavLog}"      Checked="Nav_Checked" Tag="Log"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="{loc:T NavSettings}" Checked="Nav_Checked" Tag="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== CONTENT ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="28,22,28,14">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="24" Fill="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,0">
                <Grid>

                    <!-- ===================== STATUS ===================== -->
                    <StackPanel x:Name="PageStatus">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T ProtectionTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T ProtectionBlurb}"/>
                                <WrapPanel Margin="0,15,0,0">
                                    <Button x:Name="BtnStart"     Style="{StaticResource PrimaryButton}" Content="{loc:T BtnStart}" Click="BtnStart_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnStop"      Content="{loc:T BtnStop}"      Click="BtnStop_Click"      Margin="0,0,8,8"/>
                                    <Button x:Name="BtnInstall"   Content="{loc:T BtnInstall}"   Click="BtnInstall_Click"   Margin="0,0,8,8"/>
                                    <Button x:Name="BtnUninstall" Content="{loc:T BtnUninstall}" Click="BtnUninstall_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T QuickCheckTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T QuickCheckBlurb}"/>
                                <StackPanel x:Name="QuickCheckSummary" Orientation="Horizontal" Margin="0,13,0,0">
                                    <Ellipse x:Name="QuickCheckDot" Width="9" Height="9" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="QuickCheckText" Text="—" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Button Content="{loc:T BtnRunCheck}" Click="BtnRunCheck_Click" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T ServersTitle}"/>
                                <Border Style="{StaticResource Console}">
                                    <TextBlock x:Name="ProfilesText" Style="{StaticResource ConsoleText}" Text="…"/>
                                </Border>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="{loc:T BtnManageServers}" Click="BtnGoServers_Click" Margin="0,0,8,0"/>
                                    <Button Content="{loc:T BtnRefreshLists}"  Click="BtnReloadLists_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T RecentTitle}"/>
                                <Border Style="{StaticResource Console}">
                                    <TextBlock x:Name="MiniLogText" Style="{StaticResource ConsoleText}" Text="…"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== SERVERS ===================== -->
                    <StackPanel x:Name="PageServers" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T ServersHeading}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T ServersBlurb}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="{loc:T BtnAddServer}"      Click="BtnAddServer_Click" Margin="0,0,8,0"/>
                                    <Button Content="{loc:T BtnSaveAndRestart}" Style="{StaticResource PrimaryButton}" Click="BtnSaveServers_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ServerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T FieldName}"/>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{loc:T BtnRemoveServer}" Click="BtnRemoveServer_Click"
                                                        Tag="{Binding}" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T FieldPublicPort}"/>
                                                    <TextBox Text="{Binding PublicPort, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T FieldBackendHost}"/>
                                                    <TextBox Text="{Binding BackendHost, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T FieldBackendPort}"/>
                                                    <TextBox Text="{Binding BackendPort, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T FieldProtectedNames}"/>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6" Text="{loc:T ProtectedNamesBlurb}"/>
                                            <TextBox Text="{Binding ProtectedNamesText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" MinHeight="66" TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                                                     Margin="0,0,0,14"/>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T FieldAllowedDomains}"/>
                                            <TextBox Text="{Binding AllowedHostnamesText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" MinHeight="48" TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===================== SECURITY CHECK ===================== -->
                    <StackPanel x:Name="PageSecurity" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T LeakHeading}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T LeakBlurb}"/>
                                <Button x:Name="BtnRunCheckPage" Content="{loc:T BtnRunCheck}" Style="{StaticResource PrimaryButton}"
                                        Click="BtnRunCheck_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="CheckResultList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,14,2"
                                                    Background="{Binding VerdictBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding VerdictLabel}" Margin="10,0,0,0"
                                                               Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                                <Border Background="#1A0F13" BorderBrush="#3A1620" BorderThickness="1" CornerRadius="3"
                                                        Padding="11,8" Margin="0,9,0,0" Visibility="{Binding FixVisibility}">
                                                    <TextBlock Text="{Binding Fix}" Style="{StaticResource Muted}" Foreground="#E8B4BC"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===================== BANS ===================== -->
                    <StackPanel x:Name="PageBans" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T BansHeading}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T BansBlurb}"/>
                                <Border Style="{StaticResource Console}" Margin="0,13,0,0">
                                    <TextBlock x:Name="BansText" Style="{StaticResource ConsoleText}" FontSize="12" Text="…"/>
                                </Border>
                                <WrapPanel Margin="0,14,0,0">
                                    <TextBox x:Name="UnbanIpBox" Width="200" Margin="0,0,8,0"
                                             FontFamily="Cascadia Mono, Consolas, monospace" VerticalContentAlignment="Center"/>
                                    <Button Content="{loc:T BtnUnban}"   Click="BtnUnban_Click" Margin="0,0,8,0"/>
                                    <Button Content="{loc:T BtnRefresh}" Click="BtnRefreshBans_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== LOG ===================== -->
                    <StackPanel x:Name="PageLog" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T LogHeading}"/>
                                <Border Style="{StaticResource Console}">
                                    <ScrollViewer x:Name="LogScroller" Height="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="FullLogText" Style="{StaticResource ConsoleText}"/>
                                    </ScrollViewer>
                                </Border>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="{loc:T BtnOpenLogFolder}" Click="BtnOpenLogs_Click" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="ChkAutoScroll" Content="{loc:T ChkFollow}" IsChecked="True" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== DEFENCE ===================== -->
                    <StackPanel x:Name="PageDefense" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T DefLiveTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T DefLiveBlurb}"/>
                                <Border Style="{StaticResource Console}" Margin="0,12,0,0">
                                    <TextBlock x:Name="DefenseStatusText" Style="{StaticResource ConsoleText}" Text="…"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T DefFloodTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T DefFloodBlurb}"/>
                                <CheckBox x:Name="ChkDdos" Margin="0,13,0,0" Content="{loc:T ChkDdos}" Click="DefenseToggle_Changed" Tag="DdosProtection/Enabled"/>
                                <CheckBox x:Name="ChkInspection" Margin="0,10,0,0" Content="{loc:T ChkInspection}" Click="DefenseToggle_Changed" Tag="DeepInspection/Enabled"/>
                                <CheckBox x:Name="ChkInjection" Margin="0,10,0,0" Content="{loc:T ChkInjection}" Click="DefenseToggle_Changed" Tag="DeepInspection/ScanForInjectionPayloads"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T DefBotTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T DefBotBlurb}"/>
                                <RadioButton x:Name="BotLogOnly" GroupName="BotAction" Margin="0,13,0,0" Content="{loc:T BotLogOnly}" Checked="BotAction_Changed" Tag="LogOnly"/>
                                <RadioButton x:Name="BotDeny"    GroupName="BotAction" Margin="0,9,0,0"  Content="{loc:T BotDeny}"    Checked="BotAction_Changed" Tag="Deny"/>
                                <Border Background="#12141A" BorderBrush="#242833" BorderThickness="1" CornerRadius="3" Padding="11,9" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Muted}" Text="{loc:T BotActionNote}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T DefHoneypotTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T DefHoneypotBlurb}"/>
                                <CheckBox x:Name="ChkHoneypot" Margin="0,13,0,0" Content="{loc:T ChkHoneypot}" Click="DefenseToggle_Changed" Tag="Honeypot/Enabled"/>
                                <TextBlock x:Name="HoneypotPortsText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                <Border Style="{StaticResource Console}" Margin="0,12,0,0">
                                    <TextBlock x:Name="ThreatListText" Style="{StaticResource ConsoleText}" Text="…"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T DefMovementTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T DefMovementBlurb}"/>
                                <CheckBox x:Name="ChkMovement" Margin="0,13,0,0" Content="{loc:T ChkMovement}" Click="DefenseToggle_Changed" Tag="DeepInspection/AnalyseMovement"/>
                                <CheckBox x:Name="ChkMovementKick" Margin="0,10,0,0" Content="{loc:T ChkMovementKick}" Click="DefenseToggle_Changed" Tag="DeepInspection/KickOnMovementAnomaly"/>
                                <Border Background="#1A0F13" BorderBrush="#3A1620" BorderThickness="1" CornerRadius="3" Padding="11,9" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Muted}" Foreground="#E8B4BC" Text="{loc:T MovementKickWarning}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T DefAnomalyTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T DefAnomalyBlurb}"/>
                                <CheckBox x:Name="ChkAnomaly" Margin="0,13,0,0" Content="{loc:T ChkAnomaly}" Click="DefenseToggle_Changed" Tag="AnomalyDetection/Enabled"/>
                                <Border Background="#12141A" BorderBrush="#242833" BorderThickness="1" CornerRadius="3" Padding="11,9" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Muted}" Text="{loc:T AnomalyNote}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T DefRestartTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T DefRestartBlurb}"/>
                                <Button Content="{loc:T BtnApplyRestart}" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="BtnRestartService_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== SETTINGS ===================== -->
                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T SettingsLanguageTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <RadioButton x:Name="LangEn" GroupName="Lang" Content="English" Margin="0,0,22,0" Checked="Language_Changed" Tag="en"/>
                                    <RadioButton x:Name="LangTr" GroupName="Lang" Content="Türkçe" Checked="Language_Changed" Tag="tr"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T SettingsProtectionTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T SettingsProtectionBlurb}"/>
                                <RadioButton x:Name="StartAuto"   GroupName="StartMode" Content="{loc:T StartAuto}"   Margin="0,13,0,0" Checked="StartMode_Changed"/>
                                <RadioButton x:Name="StartManual" GroupName="StartMode" Content="{loc:T StartManual}" Margin="0,9,0,0"  Checked="StartMode_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T SettingsPremiumTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T SettingsPremiumBlurb}"/>
                                <CheckBox x:Name="ChkAutoPremium" Margin="0,13,0,0" Content="{loc:T ChkAutoPremium}" Click="AutoPremium_Changed"/>
                                <Border Background="#1A0F13" BorderBrush="#3A1620" BorderThickness="1" CornerRadius="3" Padding="11,9" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Muted}" Foreground="#E8B4BC" Text="{loc:T AutoPremiumWarning}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T SettingsWindowTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:T SettingsWindowBlurb}"/>
                                <CheckBox x:Name="ChkLoginStartup"   Margin="0,13,0,6" Content="{loc:T ChkLoginStartup}"   Click="StartupPreference_Changed"/>
                                <CheckBox x:Name="ChkStartMinimised" Margin="0,0,0,6"  Content="{loc:T ChkStartMinimised}" Click="StartupPreference_Changed"/>
                                <CheckBox x:Name="ChkCloseToTray"    IsChecked="True"  Content="{loc:T ChkCloseToTray}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T SettingsFilesTitle}"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="{loc:T BtnOpenConfig}"    Click="BtnEditConfig_Click" Margin="0,0,8,0"/>
                                    <Button Content="{loc:T BtnOpenLogFolder}" Click="BtnOpenLogs_Click"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{loc:T ConfigRestartNote}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <Border x:Name="ToastBar" Grid.Row="2" Visibility="Collapsed" Padding="28,13"
                    Background="#141014" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <Rectangle x:Name="ToastRail" Width="3" Fill="{StaticResource Accent}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
